rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function emailLower() {
      return request.auth.token.email.lower();
    }

    function isClinician() {
      return signedIn() && (
        exists(/databases/$(database)/documents/clinician_accounts/$(emailLower())) ||
        exists(/databases/$(database)/documents/clinician_accounts/$(request.auth.uid))
      );
    }

    match /clinician_accounts/{accountId} {
      allow get, list: if signedIn() &&
        (accountId == emailLower() || accountId == request.auth.uid || resource.data.email == request.auth.token.email);
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read, update: if isClinician();
      allow create: if request.auth != null;
      allow delete: if false;
    }

    match /analytics/{document=**} {
      allow read: if isClinician();
      allow write: if false;
    }

    match /patient_reports/{reportId} {
      allow read: if isClinician();
      allow write: if request.auth != null;
    }

    match /follow_up_surveys/{surveyId} {
      allow read: if isClinician();
      allow create: if request.auth != null;
      allow update: if isClinician();
      allow delete: if false;
    }
  }
}
