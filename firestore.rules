rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function emailLower() {
      return request.auth.token.email.lower();
    }

    function isClinician() {
      return signedIn() &&
        exists(/databases/$(database)/documents/clinician_accounts/$(emailLower())) &&
        (
          !("active" in clinicianAccount()) ||
          clinicianAccount().active == true
        );
    }

    function clinicianAccount() {
      return get(/databases/$(database)/documents/clinician_accounts/$(emailLower())).data;
    }

    function canAccessHospital(hospitalId) {
      return isClinician() && (
        clinicianAccount().role == "super_admin" ||
        clinicianAccount().hospitalId == hospitalId ||
        (
          "hospitalIds" in clinicianAccount() &&
          clinicianAccount().hospitalIds is list &&
          hospitalId in clinicianAccount().hospitalIds
        ) ||
        (
          !("hospitalId" in clinicianAccount()) &&
          !("hospitalIds" in clinicianAccount()) &&
          hospitalId == "esth"
        )
      );
    }

    match /clinician_accounts/{accountId} {
      allow read: if
        (
          signedIn() &&
          accountId == emailLower() &&
          resource.data.email == request.auth.token.email
        ) ||
        (
          isClinician() &&
          canAccessHospital(resource.data.hospitalId)
        );
      allow write: if false;
    }

    match /patient_assessments/{assessmentId} {
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.assessmentId == assessmentId &&
        request.resource.data.hospitalId is string;
      allow read: if canAccessHospital(resource.data.hospitalId);
      allow update: if
        canAccessHospital(resource.data.hospitalId) ||
        (
          request.auth != null &&
          resource.data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.hospitalId == resource.data.hospitalId &&
          request.resource.data.assessmentId == resource.data.assessmentId
        );
      allow delete: if false;

      match /{subcollection}/{documentId} {
        allow read: if
          resource.data.hospitalId ==
            get(/databases/$(database)/documents/patient_assessments/$(assessmentId)).data.hospitalId &&
          canAccessHospital(resource.data.hospitalId);
        allow create, update: if
          request.resource.data.hospitalId ==
            get(/databases/$(database)/documents/patient_assessments/$(assessmentId)).data.hospitalId &&
          canAccessHospital(request.resource.data.hospitalId);
        allow delete: if false;
      }
    }

    // Compatibility for deployed dashboard collection-group listeners.
    match /{path=**}/preClinicQuestionnaire/{documentId} {
      allow read: if
        resource.data.hospitalId is string &&
        canAccessHospital(resource.data.hospitalId);
    }

    match /{path=**}/clinicianReview/{documentId} {
      allow read: if
        resource.data.hospitalId is string &&
        canAccessHospital(resource.data.hospitalId);
    }

    match /whatsappContacts/{documentId} {
      allow read: if canAccessHospital(resource.data.hospitalId);
      allow write: if false;
    }

    match /whatsappInboundQueue/{documentId} {
      allow read: if canAccessHospital(resource.data.hospitalId);
      allow write: if false;
    }
  }
}
